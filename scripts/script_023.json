    {
      "sender": "other",
      "text": "名前がローマ字でRONと"
    },
    {
      "sender": "self",
      "text": "グローバルですね"
    },
    {
      "sender": "other",
      "text": "田中ロンてなんやねん"
    },
    {
      "sender": "other",
      "text": "取引先にもhello連発や"
    },
    {
      "sender": "self",
      "text": "度胸ありますね"
    },
    {
      "sender": "other",
      "text": "先方、翻訳アプリ起動しよった"
    },
    {
      "sender": "self",
      "text": "国際会議ですね"
    },
    {
      "sender": "other",
      "text": "ただの定例会議や"
