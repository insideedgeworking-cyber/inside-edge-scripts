    {
      "type": "telop",
      "text": "翌日・新人が英和辞書を持参"
    },
    {
      "sender": "other",
      "text": "鈍器みたいな辞書抱えてきた"
    },
    {
      "sender": "self",
      "text": "やる気ありますね"
