    {
      "sender": "self",
      "text": "完璧ですね"
    },
    {
      "sender": "other",
      "text": "完璧ちゃう！"
    },
    {
      "sender": "other",
      "text": "なんでそんな嘘ついた"
    },
    {
      "sender": "self",
