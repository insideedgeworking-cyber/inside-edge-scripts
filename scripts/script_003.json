  "title": "【LINE】新人が上司の席にコーヒーを何杯も置き続けた理由 #職場あるある #LINEドラマ #Shorts",
  "genre": "笑い系",
  "category": "笑い_上司部下",
  "setup": "新人に「上司は毎朝コーヒー2杯飲まないと名前が覚えられない」という嘘を吹き込んだ",
  "messages": [
    {
      "type": "telop",
      "text": "新人・入社2ヶ月・素直すぎる"
    },
    {
      "sender": "other",
      "text": "お前新人に何言うた"
    },
    {
      "sender": "self",
      "text": "褒めてましたよ"
    },
    {
      "sender": "other",
      "text": "朝会の前の話や"
    },
    {
      "sender": "other",
      "text": "俺の席に何か置かれてる"
    },
    {
      "sender": "other",
      "text": "何がしたいんかわからん"
    },
    {
      "sender": "other",
      "text": "お前何を教えた"
    },
    {
      "sender": "self",
      "text": "コーヒー2杯飲まないと"
    },
    {
      "sender": "self",
      "text": "名前覚えられないと教えました"
    },
    {
      "sender": "other",
      "text": "だから2杯置いてあったんか！"
    },
    {
      "sender": "other",
      "text": "横で直立不動や"
    },
    {
      "sender": "other",
      "text": "執事みたいに控えとる"
    },
    {
      "sender": "self",
      "text": "気が利きますね"
    },
    {
      "sender": "other",
      "text": "名前は最初から覚えとるわ"
    },
    {
      "sender": "self",
      "text": "新人は知らないので"
    },
    {
      "sender": "other",
      "text": "昼にもまた2杯来た"
    },
    {
      "sender": "self",
      "text": "まだ覚えてもらえてない"
    },
    {
      "sender": "other",
      "text": "覚えとるわ！"
    },
    {
      "sender": "other",
      "text": "1日でカフェ1軒分や"
    },
    {
      "sender": "self",
      "text": "経済回してますね"
    },
    {
      "sender": "other",
      "text": "俺の胃が回るわ"
    },
    {
      "type": "telop",
      "text": "翌日・新人がエプロン姿で出社"
    },
    {
      "sender": "other",
      "text": "なぜかエプロンしてる"
    },
    {
      "sender": "self",
      "text": "本格的ですね"
    },
    {
      "sender": "other",
      "text": "「専属バリスタです」て名乗った"
    },
    {
      "sender": "self",
      "text": "立派な志です"
    },
    {
      "sender": "other",
      "text": "志ちゃう！"
    },
    {
      "sender": "other",
      "text": "ラテアートで俺の顔描いてきた"
    },
    {
      "sender": "self",
      "text": "似てました？"
    },
    {
      "sender": "other",
      "text": "沼の妖怪みたいやった"
    },
    {
      "sender": "self",
      "text": "芸術的ですね"
    },
    {
      "sender": "other",
      "text": "飲む気失せるわ"
    },
    {
      "type": "telop",
      "text": "翌週・3万のエスプレッソマシン"
    },
    {
      "sender": "other",
      "text": "デスクに置かれてた"
    },
    {
      "sender": "self",
      "text": "高そう"
    },
    {
      "sender": "other",
      "text": "自腹で買うたらしい"
    },
    {
      "sender": "self",
      "text": "出世しましたね"
    },
    {
      "sender": "other",
      "text": "コーヒーで出世するか！"
    },
    {
      "sender": "other",
      "text": "もう止めさせてくれ"
    },
    {
      "sender": "self",
      "text": "断れる空気じゃないので"
    },
    {
      "sender": "other",
      "text": "空気で仕事すな"
    },
    {
      "sender": "self",
      "text": "毎朝2杯持参します"
    },
    {
      "sender": "other",
      "text": "お前が飲むな"
    },
    {
      "type": "telop",
      "text": "今も毎朝コーヒーが届く"
    }
  ],
